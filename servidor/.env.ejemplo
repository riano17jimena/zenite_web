# ── Copia este archivo como .env (nunca lo subas a GitHub) ──────────────────
NODE_ENV=production
PORT=3000

# Dirección pública de la API y el panel (Render) y del sitio (Netlify)
URL_API=https://zenite-api.onrender.com
URL_SITIO=https://zenitearquitectura.netlify.app
# Orígenes que pueden usar la API pública (separados por coma, sin / final)
ORIGENES_PERMITIDOS=https://zenitearquitectura.netlify.app

# Secreto para firmar enlaces de vista previa (mínimo 32 caracteres aleatorios)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRETO_SESIONES=

# ── Supabase: Project Settings → Database → Connection string ──
# Conexión con pooler (puerto 6543) para la aplicación
DATABASE_URL=postgresql://postgres.xxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Conexión directa (puerto 5432) para migraciones y respaldos
DIRECT_URL=postgresql://postgres.xxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Supabase Storage: Project Settings → API ──
ALMACENAMIENTO=supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=zenite-medios

# ── Correo (Gmail con contraseña de aplicación) ──
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_SEGURO=true
SMTP_USUARIO=zeniteark@gmail.com
SMTP_CONTRASENA=
CORREO_REMITENTE=Zenite Web <zeniteark@gmail.com>
CORREO_NOTIFICACIONES=zeniteark@gmail.com

# ── Opcionales ──
# MINUTOS_BLOQUEO=15
# HORAS_SESION=8
# MESES_RETENCION_SOLICITUDES=24
# VERSION_POLITICA=2026-11
# FFMPEG_PATH=/usr/bin/ffmpeg
